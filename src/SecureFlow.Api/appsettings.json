{
  "Authentication": {
    "Authority": "https://identity.example.com",
    "Audience": "secureflow-api",
    "RequireHttpsMetadata": true
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost"
}
